{
  "name": "@uselexora/lexora-api",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --experimental-strip-types src/main.ts",
    "prebuild": "prisma generate",
    "build": "tsdown",
    "start": "node dist/main.mjs",
    "prisma:generate": "prisma generate",
    "prisma:sync": "prisma migrate deploy && prisma generate",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "catalog:import": "node --env-file-if-exists=.env --experimental-strip-types src/cli/import-catalog.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@uselexora/lexora-contracts": "workspace:*",
    "cookie": "^1.1.1",
    "dotenv": "catalog:",
    "fastify": "catalog:",
    "openid-client": "^6.8.4",
    "prisma": "^7.9.1",
    "semver": "^7.7.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/semver": "^7.7.1",
    "tsdown": "^0.21.10",
    "typescript": "catalog:"
  }
}
