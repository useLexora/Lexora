{
  "directory": ".output/build/native",
  "manifest": "native/Cargo.toml",
  "components": {
    "shellSandbox": {
      "package": "lexora-buddy-host",
      "binary": "lexora-buddy-sandbox",
      "directory": "native-host"
    },
    "runtimeGuard": {
      "package": "lexora-buddy-host",
      "binary": "lexora-buddy-runtime-guard",
      "directory": "native-host"
    },
    "fileReader": {
      "package": "lexora-buddy-host",
      "binary": "lexora-buddy-file-reader",
      "directory": "native-host"
    },
    "serviceControl": {
      "package": "lexora-buddy-host",
      "binary": "lexora-buddy-service-control",
      "directory": "native-host"
    },
    "processControl": {
      "package": "lexora-buddy-host",
      "binary": "lexora-buddy-process-control",
      "directory": "native-host"
    },
    "privateDirectories": {
      "package": "lexora-buddy-host",
      "binary": "lexora-buddy-private-directories",
      "directory": "native-host"
    },
    "imageTransform": {
      "package": "lexora-buddy-image-transform",
      "binary": "lexora-buddy-image-transform",
      "directory": "native-image"
    }
