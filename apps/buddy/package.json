{
  "name": "@uselexora/lexora-buddy",
  "productName": "Lexora Buddy",
  "type": "module",
  "version": "0.13.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "description": "Sovereign, self-evolved personal desktop AI agent",
  "desktopName": "site.haohaoxue.LexoraBuddy",
  "author": {
    "name": "shanyuhai123",
    "email": "864299347@qq.com"
  },
  "license": "AGPL-3.0-only",
  "homepage": "https://uselexora.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/useLexora/Lexora.git",
    "directory": "apps/buddy"
  },
  "bugs": {
    "url": "https://github.com/useLexora/Lexora/issues"
  },
  "main": "./.output/build/electron/main/index.js",
  "scripts": {
    "predev": "install-electron --no && node ../../packaging/buddy/release/prepare-desktop-features.mjs",
    "dev": "electron-vite dev",
    "build": "pnpm build:desktop",
    "build:electron": "vue-tsc -b --pretty false && electron-vite build",
    "build:desktop": "node ../../packaging/buddy/release/prepare-desktop-features.mjs --release && pnpm build:electron",
    "build:native-pet": "cargo build --locked --target-dir .output/build/native --manifest-path native/Cargo.toml --package lexora-buddy-pet --bin lexora-buddy-pet",
    "build:native-pet:release": "cargo build --locked --release --target-dir .output/build/native --manifest-path native/Cargo.toml --package lexora-buddy-pet --bin lexora-buddy-pet",
    "clean": "node ../../packaging/buddy/release/clean-output.mjs",
    "package:arch": "pnpm build:desktop && node ../../packaging/buddy/release/package-desktop.mjs --format pacman",
    "package:deb": "pnpm build:desktop && node ../../packaging/buddy/release/package-desktop.mjs --format deb",
    "package:rpm": "pnpm build:desktop && node ../../packaging/buddy/release/package-desktop.mjs --format rpm",
    "package:macos": "pnpm build:desktop && node ../../packaging/buddy/release/package-desktop.mjs --format dmg",
    "package:windows": "pnpm build:desktop && node ../../packaging/buddy/release/package-desktop.mjs --format nsis",
    "package:pet": "pnpm build:native-pet:release && node ../../packaging/buddy/release/package-pet.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "vue-tsc -b --pretty false",
    "prepare:test-runtime": "node ../../packaging/buddy/release/search-tools.mjs && node ../../packaging/buddy/release/shell-sandbox.mjs && node ../../packaging/buddy/release/native-host.mjs",
    "test": "vitest run --maxWorkers=4",
    "test:unit": "pnpm test --project=unit",
    "test:runtime": "pnpm test --project=runtime",
    "test:platform": "pnpm test --project=platform",
    "test:sandbox:windows": "node --test native/host/__tests__/shell_sandbox.windows.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.79",
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/util-format-url": "3.972.50",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@mozilla/readability": "^0.6.0",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@smithy/types": "4.19.0",
    "diff": "^9.0.0",
    "electron-updater": "6.8.9",
    "eventemitter2": "6.4.9",
    "fflate": "0.8.3",
    "linkedom": "^0.18.13",
    "minisearch": "7.2.0",
    "proxy-chain": "^3.0.1",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.1",
    "turndown": "^7.2.4",
    "typebox": "^1.3.36",
    "undici": "8.10.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@antv/x6": "^3.1.8",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/vue": "^0.5.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "@types/node": "catalog:",
    "@types/semver": "^7.8.0",
    "@types/turndown": "^5.0.6",
    "@unocss/core": "66.10.5",
    "@vicons/fluent": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.0.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "echarts": "^6.1.0",
    "electron": "44.7.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "katex": "^0.19.0",
    "marked": "^18.1.0",
    "markstream-vue": "^2.0.19",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.57.0",
    "naive-ui": "^2.45.3",
    "sass-embedded": "^1.105.1",
    "typescript": "catalog:",
    "unocss": "^66.10.5",
    "vite": "^8.3.4",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  }
}
