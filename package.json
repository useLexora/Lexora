{
  "name": "@uselexora/lexora",
  "type": "module",
  "version": "0.8.8",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.5.1"
  },
  "scripts": {
    "dev": "pnpm dev:buddy",
    "dev:env": "node infrastructure/scripts/sync-dev-env.mjs",
    "dev:infra": "docker compose --env-file infrastructure/.env -f infrastructure/compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f infrastructure/compose.dev.yml down",
    "predev:db:sync": "pnpm dev:env",
    "dev:db:sync": "pnpm --filter @haohaoxue/lexora-api prisma:sync",
    "predev:db:reset": "pnpm dev:env",
    "dev:db:reset": "pnpm --filter @haohaoxue/lexora-api exec prisma db push --force-reset",
    "predev:api": "pnpm dev:env",
    "dev:web": "pnpm --filter @haohaoxue/lexora-web dev",
    "dev:api": "pnpm --filter @haohaoxue/lexora-api dev",
    "predev:agent": "pnpm dev:env",
    "dev:agent": "pnpm --filter @haohaoxue/lexora-agent dev",
    "dev:buddy": "pnpm --filter @uselexora/lexora-buddy dev",
    "dev:website": "pnpm --filter @uselexora/lexora-website dev",
    "build": "pnpm --filter @uselexora/lexora-buddy build",
    "build:website": "pnpm --filter @uselexora/lexora-website build",
    "preview:website": "pnpm --filter @uselexora/lexora-website preview",
    "package:buddy:deb": "RUST_MIN_STACK=16777216 pnpm --filter @uselexora/lexora-buddy package:deb",
    "build:buddy:pet": "RUST_MIN_STACK=16777216 pnpm --filter @uselexora/lexora-buddy package:pet",
    "release:version:check": "node packaging/release/version.mjs --check",
    "release:version:set": "node packaging/release/version.mjs --set",
    "release:status": "node packaging/release/status.mjs",
    "check:buddy": "node packaging/buddy/release/preflight.mjs",
    "check:website": "pnpm --filter @uselexora/lexora-website lint && pnpm --filter @uselexora/lexora-website type-check && pnpm --filter @uselexora/lexora-website build",
    "test": "pnpm --filter @uselexora/lexora-buddy test",
    "test:watch": "pnpm --filter @uselexora/lexora-buddy test:watch",
    "lint": "eslint eslint.config.js .github/scripts apps/buddy apps/website packages/assets packaging infrastructure/scripts",
    "lint:fix": "pnpm lint --fix",
    "type-check": "pnpm --filter @uselexora/lexora-buddy --filter @uselexora/lexora-website type-check",
    "predev:web-stack": "pnpm dev:env",
    "dev:web-stack": "pnpm -r --parallel --filter '!@uselexora/lexora-buddy' --filter '!@uselexora/lexora-website' --if-present dev",
    "build:web-stack": "pnpm --filter '@haohaoxue/lexora-web...' --filter '@haohaoxue/lexora-api...' --filter '@haohaoxue/lexora-agent...' --recursive --if-present build",
    "test:web-stack": "pnpm --filter '@haohaoxue/lexora-web...' --filter '@haohaoxue/lexora-api...' --filter '@haohaoxue/lexora-agent...' --recursive --if-present test",
    "lint:web-stack": "eslint apps/agent apps/api apps/web packages/contracts packages/shared",
    "lint:fix:web-stack": "pnpm lint:web-stack --fix",
    "type-check:web-stack": "pnpm --filter '@haohaoxue/lexora-web...' --filter '@haohaoxue/lexora-api...' --filter '@haohaoxue/lexora-agent...' --recursive --if-present type-check"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "eslint": "^10.2.1",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
